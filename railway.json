{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "buildCommand": "cd saas-astrologico/crm && npm ci && npm run build && npx prisma generate"
  },
  "deploy": {
    "startCommand": "cd saas-astrologico/crm && node dist/index.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
