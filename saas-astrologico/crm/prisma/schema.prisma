// ─── Prisma Schema — CRM Luz Holística ────────────────────────────────────────
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Multi-tenant: Organización ───────────────────────────────────────────────
model Organizacion {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nombre  String
  slug    String  @unique   // ej: "luz-holistica" — usado en URLs
  plan    String  @default("interno") // interno | starter | pro
  activa  Boolean @default(true)

  // Relaciones
  usuarios           Usuario[]
  contactos          Contacto[]
  campanas           Campana[]
  oportunidades      Oportunidad[]
  smtpConfigs        SmtpConfig[]
  secuencias         Secuencia[]
  automatizaciones   Automatizacion[]

}

// ─── Usuarios del sistema ─────────────────────────────────────────────────────
model Usuario {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nombre   String
  email    String
  password String  // bcrypt hash
  rol      String  @default("agente") // admin | agente
  activo   Boolean @default(true)

  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@unique([email, organizacionId])
  @@index([organizacionId])

}

// ─── Contacto ─────────────────────────────────────────────────────────────────
model Contacto {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── Datos de contacto ────────────────────────────────────────────────────────
  nombre       String?
  email        String
  telefono     String?
  usuarioRedes String?

  // ── Perfil profesional ───────────────────────────────────────────────────────
  especialidadPrimaria   String  @default("otro")
  especialidadSecundaria String?
  nivelExperiencia       String  @default("principiante")
  formacion              String?
  certificaciones        String? // JSON array serializado

  // ── Ubicación ────────────────────────────────────────────────────────────────
  pais        String @default("MX")
  ciudad      String?
  region      String?
  zonaHoraria String?

  // ── Presencia digital ────────────────────────────────────────────────────────
  instagramUrl        String?
  instagramSeguidores Int?
  tiktokUrl           String?
  tiktokSeguidores    Int?
  facebookUrl         String?
  youtubeUrl          String?
  webUrl              String?
  telegramUsername    String?

  // ── Scoring y estado ─────────────────────────────────────────────────────────
  leadScore         Int      @default(0)
  estado            String   @default("prospecto")
  etiquetas         String   @default("[]")
  interacciones     Int      @default(0)
  ultimaInteraccion DateTime?

  // ── Pipeline ─────────────────────────────────────────────────────────────────
  notas             String?
  proximosPasos     String?
  proximaAccionFecha DateTime?

  // ── Fuente de captura ────────────────────────────────────────────────────────
  fuente String @default("manual")

  // ── Consentimiento ───────────────────────────────────────────────────────────
  consentimientoEmail  Boolean   @default(false)
  fechaConsentimiento  DateTime?
  fuenteConsentimiento String?

  // ── Integración MailerLite ───────────────────────────────────────────────────
  mailerliteId       String?
  mailerliteSyncedAt DateTime?

  // ── Métricas de email ────────────────────────────────────────────────────────
  emailsEnviados Int @default(0)
  emailsAbiertos Int @default(0)
  emailsClicados Int @default(0)

  // ── Multi-tenant ─────────────────────────────────────────────────────────────
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  // ── Relaciones ───────────────────────────────────────────────────────────────
  acciones      Accion[]
  oportunidades Oportunidad[]

  @@unique([email, organizacionId])
  @@index([organizacionId])
  @@index([estado])
  @@index([pais])
  @@index([especialidadPrimaria])
  @@index([leadScore])

}

// ─── Historial de acciones sobre un contacto ──────────────────────────────────
model Accion {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  tipo            String
  descripcion     String?
  puntosAplicados Int @default(0)

  contactoId String
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  @@index([contactoId])

}

// ─── Pipeline de ventas: Oportunidad ─────────────────────────────────────────
// Etapas: prospecto → contactado → propuesta → negociacion → cerrado_ganado | cerrado_perdido
model Oportunidad {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  titulo      String
  descripcion String?
  etapa       String  @default("prospecto")
  // prospecto | contactado | propuesta | negociacion | cerrado_ganado | cerrado_perdido

  valor       Float   @default(0)      // valor estimado del deal (MXN)
  probabilidad Int    @default(0)      // % 0-100
  fechaCierre  DateTime?               // fecha estimada de cierre

  motivoPerdida String?                // por qué se perdió (si aplica)
  notas         String?

  // Contacto asociado (opcional — puede ser un prospecto sin email)
  contactoId    String?
  contacto      Contacto? @relation(fields: [contactoId], references: [id], onDelete: SetNull)

  // Responsable (usuario que lleva el deal)
  responsableId String?

  // Multi-tenant
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId])
  @@index([etapa])
  @@index([contactoId])

}

// ─── Configuración de proveedores SMTP/Email ──────────────────────────────────
model SmtpConfig {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nombre        String
  tipo          String  // resend | smtp | brevo | sendgrid
  api_key       String?
  host          String?
  port          Int?
  secure        Boolean?
  usuario       String?
  password      String?
  fromEmail     String
  fromNombre    String
  activo        Boolean @default(true)
  predeterminado Boolean @default(false)

  // ── Multi-tenant ─────────────────────────────────────────────────────
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId])

}

// ─── Campañas de email ────────────────────────────────────────────────────────
model Campana {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nombre      String
  descripcion String?
  tipo        String @default("email")
  estado      String @default("borrador")
  segmento    String?
  mailerliteId String?

  totalContactos Int @default(0)
  totalEnviados  Int @default(0)
  totalAbiertos  Int @default(0)
  totalClics     Int @default(0)

  // ── Multi-tenant ─────────────────────────────────────────────────────────────
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId])

}

// ─── Secuencias de automatización ──────────────────────────────────────────────
model Secuencia {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nombre        String
  descripcion   String?
  tipo          String   @default("bienvenida") // bienvenida | seguimiento | especial
  activo        Boolean  @default(true)

  // ── Pasos ─────────────────────────────────────────────────────────────────────
  pasos         SecuenciaPaso[]

  // ── Relaciones ────────────────────────────────────────────────────────────────
  automatizaciones Automatizacion[]

  // ── Multi-tenant ──────────────────────────────────────────────────────────────
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId])
  @@index([activo])

}

// ─── Pasos dentro de una secuencia ────────────────────────────────────────────
model SecuenciaPaso {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orden      Int
  tipo       String   // email | sms | webhook | delay | decision
  activo     Boolean  @default(true)

  // ── Configuración específica del tipo de acción ──────────────────────────────
  config     Json     // {template, subject, etc. según tipo}

  // ── Condición para skipear este paso ──────────────────────────────────────────
  condicion_skip Json?  // {campo, operador, valor}

  // ── Relación con Secuencia ────────────────────────────────────────────────────
  secuenciaId String
  secuencia   Secuencia @relation(fields: [secuenciaId], references: [id], onDelete: Cascade)

  @@index([secuenciaId])
  @@index([orden])

}

// ─── Automatizaciones: triggers que lanzam secuencias ──────────────────────────
model Automatizacion {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nombre              String
  descripcion         String?
  activo              Boolean  @default(true)

  // ── Trigger ───────────────────────────────────────────────────────────────────
  trigger_evento      String   // contacto_creado | email_abierto | etc.
  trigger_condiciones Json?    // {field: value, ...}

  // ── Relación con Secuencia ────────────────────────────────────────────────────
  secuenciaId String
  secuencia   Secuencia @relation(fields: [secuenciaId], references: [id], onDelete: Cascade)

  // ── Estadísticas ──────────────────────────────────────────────────────────────
  total_ejecuciones  Int      @default(0)
  ultima_ejecucion   DateTime?

  // ── Logs ──────────────────────────────────────────────────────────────────────
  logs               AutomatizacionLog[]

  // ── Multi-tenant ──────────────────────────────────────────────────────────────
  organizacionId String
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId])
  @@index([trigger_evento])
  @@index([activo])

}

// ─── Logs de ejecución de automatizaciones ────────────────────────────────────
model AutomatizacionLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  automatizacionId String
  automatizacion   Automatizacion @relation(fields: [automatizacionId], references: [id], onDelete: Cascade)

  secuenciaId String?
  evento      String
  estado      String  // en_progreso | completado | fallido

  // ── Contexto ──────────────────────────────────────────────────────────────────
  contactoId String?
  contexto   Json?
  pasos_ejecutados Json? // [{tipo, ok, detalle/error}]

  @@index([automatizacionId])
  @@index([contactoId])
  @@index([estado])

}
