# ─── Servidor ────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Modo autenticación ───────────────────────────────────────
# En Railway: false (activa login con JWT)
LOCAL_DEV=false

# ─── Base de datos PostgreSQL ─────────────────────────────────
# Railway genera esto automáticamente al agregar el plugin PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── JWT ──────────────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=genera_un_secreto_seguro_aqui

# ─── SMTP (Neubox) ────────────────────────────────────────────
SMTP_HOST=mail.luzholistica.com.mx
SMTP_PORT=465
SMTP_USER=contacto@luzholistica.com.mx
SMTP_PASS=tu_contrasena_smtp
SMTP_FROM=AstroTherapy Pro <contacto@luzholistica.com.mx>

# ─── Apify ────────────────────────────────────────────────────
APIFY_TOKEN=tu_token_de_apify

# ─── MailerLite (opcional) ────────────────────────────────────
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ASTROLOGOS=
MAILERLITE_GROUP_TERAPEUTAS=
MAILERLITE_GROUP_EARLY_ADOPTERS=
MAILERLITE_GROUP_CLIENTES=
